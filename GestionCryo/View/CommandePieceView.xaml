<UserControl x:Class="GestionCryo.View.CommandePieceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="650"
             d:DesignWidth="950"
             Background="Transparent">

    <UserControl.Resources>
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1D4ED8"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#1E40AF"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#93C5FD"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="#4B5563"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#374151"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#1F2937"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#CBD5E1"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Background="#F4F7FB" Margin="8">
        <Border Background="White"
                CornerRadius="20"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                Padding="28">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="24"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="Commandes de pièces"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="#0F172A"/>

                    <TextBlock Text="Créer et suivre les demandes de pièces pour les bateaux."
                               FontSize="14"
                               Foreground="#64748B"
                               Margin="0,8,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320"/>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Background="#F8FAFC"
                            CornerRadius="16"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            Padding="20">
                        <StackPanel>
                            <TextBlock Text="Nouvelle commande"
                                       Style="{StaticResource SectionTitleStyle}"/>

                            <TextBlock Text="Nom de la pièce"
                                       Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding NomPiece, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource InputStyle}"/>

                            <TextBlock Text="Quantité"
                                       Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding Quantite, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource InputStyle}"/>

                            <TextBlock Text="Bateau sélectionné"
                                       Style="{StaticResource LabelStyle}"/>
                            <TextBlock Text="{Binding BateauSelectionne.Nom, TargetNullValue=Aucun bateau sélectionné}"
                                       FontSize="14"
                                       Foreground="#0F172A"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,16"
                                       TextWrapping="Wrap"/>

                            <TextBlock Text="{Binding ErrorMessages}"
                                       Foreground="#DC2626"
                                       FontSize="13"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,14"/>

                            <Button Content="Créer la commande"
                                    Command="{Binding AjouterCommandeCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2"
                            Background="#F8FAFC"
                            CornerRadius="16"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            Padding="20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="16"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="16"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0">
                                <TextBlock Text="Liste des commandes"
                                           Style="{StaticResource SectionTitleStyle}"/>

                                <TextBlock Text="Sélectionnez une commande pour changer son statut."
                                           FontSize="13"
                                           Foreground="#64748B"/>
                            </StackPanel>

                            <ListView Grid.Row="2"
                                      ItemsSource="{Binding CommandesPieces}"
                                      SelectedItem="{Binding CommandeSelectionnee}"
                                      BorderBrush="#E2E8F0"
                                      BorderThickness="1"
                                      Background="White">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Pièce"
                                                        DisplayMemberBinding="{Binding NomPiece}"
                                                        Width="180"/>
                                        <GridViewColumn Header="Quantité"
                                                        DisplayMemberBinding="{Binding Quantite}"
                                                        Width="90"/>
                                        <GridViewColumn Header="Statut"
                                                        DisplayMemberBinding="{Binding Statut}"
                                                        Width="120"/>
                                        <GridViewColumn Header="Date"
                                                        DisplayMemberBinding="{Binding DateCommande}"
                                                        Width="170"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>

                            <StackPanel Grid.Row="4"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Right">
                                <Button Content="Marquer livrée"
                                        Width="150"
                                        Margin="0,0,12,0"
                                        Command="{Binding MarquerLivreeCommand}"
                                        Style="{StaticResource PrimaryButtonStyle}"/>

                                <Button Content="Annuler"
                                        Width="120"
                                        Command="{Binding AnnulerCommandeCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>

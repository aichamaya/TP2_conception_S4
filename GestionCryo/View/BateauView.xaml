<UserControl x:Class="GestionCryo.View.BateauView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="700"
             d:DesignWidth="950"
             Background="Transparent">

    <UserControl.Resources>
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="ValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="EditTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1D4ED8"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#1E40AF"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#93C5FD"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid Background="#F4F7FB" Margin="8">
            <Border Background="White"
                    CornerRadius="20"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    Padding="28">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Titre -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,24">
                        <TextBlock Text="Détails du bateau"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="#0F172A"/>

                        <TextBlock Text="{Binding AfficheService.BateauAffiche.Nom, StringFormat=Bateau sélectionné : {0}}"
                                   FontSize="14"
                                   Foreground="#64748B"
                                   Margin="0,8,0,0"/>
                    </StackPanel>

                    <!-- Infos générales -->
                    <Border Grid.Row="1"
                            Background="#F8FAFC"
                            CornerRadius="16"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            Padding="20"
                            Margin="0,0,0,20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="Informations générales"
                                           Style="{StaticResource SectionTitleStyle}"/>

                                <TextBlock Text="Nom" Style="{StaticResource LabelStyle}"/>
                                <TextBlock Text="{Binding AfficheService.BateauAffiche.Nom}" Style="{StaticResource ValueStyle}"/>

                                <TextBlock Text="Modèle" Style="{StaticResource LabelStyle}"/>
                                <TextBlock Text="{Binding AfficheService.BateauAffiche.Modele}" Style="{StaticResource ValueStyle}"/>

                                <TextBlock Text="Année de construction" Style="{StaticResource LabelStyle}"/>
                                <TextBlock Text="{Binding AfficheService.BateauAffiche.AnneeConstruction}" Style="{StaticResource ValueStyle}"/>

                                <TextBlock Text="Classe" Style="{StaticResource LabelStyle}"/>
                                <TextBlock Text="{Binding AfficheService.BateauAffiche.Classe}" Style="{StaticResource ValueStyle}"/>

                                <TextBlock Text="Station proche (Id)" Style="{StaticResource LabelStyle}"/>
                                <TextBlock Text="{Binding AfficheService.BateauAffiche.StationProcheId}" Style="{StaticResource ValueStyle}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="16,0,0,0">
                                <TextBlock Text="État du bateau"
                                           Style="{StaticResource SectionTitleStyle}"/>

                                <TextBlock Text="État actuel affiché" Style="{StaticResource LabelStyle}"/>
                                <TextBlock Text="{Binding EtatActuelAffiche}" Style="{StaticResource ValueStyle}"/>

								<TextBlock Text="Nouvel état" Style="{StaticResource LabelStyle}"/>
								<ComboBox ItemsSource="{Binding EtatsPossibles}"
										  SelectedItem="{Binding EtatSelectionne}"
										  Height="40"
										  Margin="0,0,0,14"
										  FontSize="14"
										  Padding="10,6"
										  Background="#F8FAFC"
										  BorderBrush="#CBD5E1"
										  BorderThickness="1.5"/>

                                <Button Content="Modifier l'état"
                                        Width="170"
                                        Command="{Binding ModifierEtatCommand}"
                                        Style="{StaticResource PrimaryButtonStyle}"/>
								<Button Content="Commander des pièces"
        Command="{Binding CommanderPiecesCommand}"
        Width="200" HorizontalAlignment="Left" Margin="0 10 0 0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Parcours -->
                    <Border Grid.Row="2"
                            Background="#F8FAFC"
                            CornerRadius="16"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            Padding="20"
                            Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="Parcours en cours"
                                       Style="{StaticResource SectionTitleStyle}"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                    <TextBlock Text="Type de mission" Style="{StaticResource LabelStyle}"/>
                                    <TextBlock Text="{Binding AfficheService.BateauAffiche.ParcoursEnCours.TypeMission}" Style="{StaticResource ValueStyle}"/>

                                    <TextBlock Text="Station destination (Id)" Style="{StaticResource LabelStyle}"/>
                                    <TextBlock Text="{Binding AfficheService.BateauAffiche.ParcoursEnCours.StationDestinationId}" Style="{StaticResource ValueStyle}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="16,0,0,0">
                                    <TextBlock Text="Autonomie restante (%)" Style="{StaticResource LabelStyle}"/>
                                    <TextBlock Text="{Binding AfficheService.BateauAffiche.ParcoursEnCours.AutonomiePourcentage}" Style="{StaticResource ValueStyle}"/>

                                    <TextBlock Text="Dernière mise à jour" Style="{StaticResource LabelStyle}"/>
                                    <TextBlock Text="{Binding AfficheService.BateauAffiche.ParcoursEnCours.DerniereMiseAJour}" Style="{StaticResource ValueStyle}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Inventaire -->
                    <Border Grid.Row="3"
                            Background="#F8FAFC"
                            CornerRadius="16"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            Padding="20">
                        <StackPanel>
                            <TextBlock Text="Inventaire du bateau"
                                       Style="{StaticResource SectionTitleStyle}"/>

                            <ListView ItemsSource="{Binding Inventaire}"
                                      BorderThickness="0"
                                      Background="Transparent">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Nom"
                                                        Width="220"
                                                        DisplayMemberBinding="{Binding Nom}" />
                                        <GridViewColumn Header="Type"
                                                        Width="180"
                                                        DisplayMemberBinding="{Binding Type}" />
                                        <GridViewColumn Header="Quantité"
                                                        Width="100"
                                                        DisplayMemberBinding="{Binding Quantite}" />
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
<UserControl x:Class="GestionCryo.View.AdminHomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="900"
             Background="Transparent">

    <UserControl.Resources>
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="46"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1D4ED8"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#1E40AF"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#93C5FD"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Background="#F4F7FB" Margin="8">
        <Border Background="White"
                CornerRadius="20"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                Padding="28">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- En-tête -->
                <StackPanel Grid.Row="0" Margin="0,0,0,20">
                    <TextBlock Text="Accueil administrateur"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="#0F172A"/>

                    <TextBlock Text="Sélectionnez une station pour consulter ses détails et les bateaux à proximité."
                               FontSize="14"
                               Foreground="#64748B"
                               Margin="0,8,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <!-- Petit bloc info -->
                <Border Grid.Row="1"
                        Background="#EFF6FF"
                        BorderBrush="#BFDBFE"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="16"
                        Margin="0,0,0,20">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Nombre de stations disponibles : "
                                   FontWeight="SemiBold"
                                   Foreground="#1E3A8A"/>
                        <TextBlock Text="{Binding Stations.Count}"
                                   Foreground="#1E3A8A"/>
                    </StackPanel>
                </Border>

                <!-- Liste des stations -->
                <Border Grid.Row="2"
                        Background="#F8FAFC"
                        CornerRadius="14"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        Padding="12">
                    <ListView ItemsSource="{Binding Stations}"
                              SelectedItem="{Binding SelectedStation}"
                              BorderThickness="0"
                              Background="Transparent">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Background="White"
                                        BorderBrush="#E2E8F0"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Margin="0,0,0,10"
                                        Padding="16">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Nom}"
                                                   FontSize="18"
                                                   FontWeight="Bold"
                                                   Foreground="#0F172A"/>

                                        <TextBlock Text="{Binding Localisation}"
                                                   FontSize="14"
                                                   Foreground="#475569"
                                                   Margin="0,6,0,0"/>

                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                            <TextBlock Text="Latitude : "
                                                       FontWeight="SemiBold"
                                                       Foreground="#334155"/>
                                            <TextBlock Text="{Binding Latitude}"
                                                       Foreground="#334155"/>
                                            <TextBlock Text="    Longitude : "
                                                       Margin="16,0,0,0"
                                                       FontWeight="SemiBold"
                                                       Foreground="#334155"/>
                                            <TextBlock Text="{Binding Longitude}"
                                                       Foreground="#334155"/>
                                        </StackPanel>

                                        <TextBlock Text="{Binding Bateaux.Count, StringFormat=Nombre de bateaux à proximité : {0}}"
                                                   Margin="0,10,0,0"
                                                   FontWeight="SemiBold"
                                                   Foreground="#1D4ED8"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Border>

                <!-- Bouton -->
                <StackPanel Grid.Row="3"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,20,0,0">
                    <Button Content="Voir les détails de la station"
                            Width="240"
                            Command="{Binding VoirDetailsStationCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>